// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ── Usuario ──
model User {
  user_id      String     @id @default(uuid())
  name         String     @map("usu_name")
  lastName     String     @map("usu_last_name")
  phone        String?    @map("usu_phone")
  email        String     @unique @map("usu_email")
  passwordHash String     @map("usu_password")
  favorites    Favorite[]
  role         UserRole   @default(client) @map("usu_role")
  avatar       String?    @map("usu_avatar")

  createdAt        DateTime  @default(now()) @map("created_at")
  updateAt         DateTime  @updatedAt
  emailConfirm     Boolean   @default(false)
  loginLockedUntil DateTime? @map("usu_login_locked_until")

  status         UserStatusEnum  @default(ACTIVE)
  stories        Story[]
  twoFactorCodes TwoFactorCode[]
  trustedDevices TrustedDevice[]

  @@index([email])
  @@index([createdAt])
  @@map("tbl_user")
}

model TwoFactorCode {
  id         String           @id @default(uuid())
  user       User             @relation(fields: [userId], references: [user_id])
  userId     String           @map("tfc_user_id")
  codeHash   String           @map("tfc_code_hash")
  purpose    TwoFactorPurpose @map("tfc_purpose")
  attempts   Int              @default(0) @map("tfc_attempts")
  expiresAt  DateTime         @map("tfc_expires_at")
  consumedAt DateTime?        @map("tfc_consumed_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([userId, purpose])
  @@map("tbl_two_factor_code")
}

model TrustedDevice {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [user_id])
  userId     String    @map("trd_user_id")
  tokenHash  String    @unique @map("trd_token_hash")
  userAgent  String?   @map("trd_user_agent")
  expiresAt  DateTime  @map("trd_expires_at")
  lastUsedAt DateTime? @map("trd_last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("tbl_trusted_device")
}

// ── Planta ──
model Herb {
  herb_id     String  @id @default(uuid())
  name        String  @map("herb_name")
  description String  @map("herb_description")
  img         String  @map("herb_img")
  cultivator  String? @map("herb_cultivator")
  important   String? @map("herb_important")

  favorites  Favorite[]
  symptoms   HerbSymptom[]
  embeddings HerbEmbedding[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tbl_herb")
}

// ── Síntoma ──
model Symptom {
  symptom_id  String  @id @default(uuid())
  name        String  @unique @map("sym_name")
  description String? @map("sym_description")

  // Relación inversa para saber qué plantas tratan este síntoma
  herbs HerbSymptom[]

  @@map("tbl_symptom")
}

model HerbSymptom {
  herbId     String  @map("herb_id")
  symptomId  String  @map("symptom_id")
  partsplant String  @map("tre_parts_plant")
  prepare    String  @map("tre_prepare")
  apply      String? @map("tre_apply")

  herb    Herb    @relation(fields: [herbId], references: [herb_id], onDelete: Cascade)
  symptom Symptom @relation(fields: [symptomId], references: [symptom_id], onDelete: Cascade)

  @@id([herbId, symptomId])
  @@map("tbl_treatment")
}

// ── Favoritos ──
model Favorite {
  userId String @map("user_id")
  herbId String @map("herb_id")
  herb   Herb   @relation(fields: [herbId], references: [herb_id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@id([userId, herbId])
  @@map("tbl_favorite")
}

// ── Chat ──
model Chat {
  chat_id      String   @id @default(cuid())
  userId       String
  title        String?  @map("chat_title")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastActiveAt DateTime @map("last_active_at")

  messages ChatMessage[]

  @@index([userId])
  @@map("tbl_chat")
}

model ChatMessage {
  chatMess_id String   @id @default(cuid())
  chatId      String
  chat        Chat     @relation(fields: [chatId], references: [chat_id], onDelete: Cascade)
  role        String   @map("chatMess_role")
  parts       Json     @map("chatMess_parts")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([chatId])
  @@map("tbl_chatMessage")
}

// ── Historia / Relato ──
model Story {
  story_id    String           @id @default(uuid())
  title       String           @map("str_title")
  body        String           @map("str_body")
  status      StoryStatus      @default(DRAFT) @map("str_status")
  category    CulturalCategory @map("str_category")
  coverImage  String?          @map("str_cover_image")
  readingTime Int?             @map("str_reading_time")

  authorId String @map("author_id")
  author   User   @relation(fields: [authorId], references: [user_id], onDelete: Cascade)

  tags StoryTag[]

  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("tbl_story")
}

// ── Modelo: Etiqueta (Tag) ────────────────────────────────────
model Tag {
  tag_id  String     @id @default(uuid())
  name    String     @unique @map("tag_name") // normalizado a lowercase
  stories StoryTag[]

  @@index([name])
  @@map("tbl_tag")
}

// ── Tabla pivote: Historia ↔ Etiqueta ─────────────────────────
model StoryTag {
  storyId String @map("story_id")
  tagId   String @map("tag_id")

  story Story @relation(fields: [storyId], references: [story_id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [tag_id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@map("tbl_story_tag")
}

// ── Enums ──
enum UserRole {
  admin
  client
}

model HerbEmbedding {
  embedding_id String                     @id @default(uuid())
  herbId       String                     @map("herb_id")
  sourceType   EmbeddingSource            @map("source_type") // HERB_PROFILE | HERB_SYMPTOM
  sourceId     String                     @map("source_id") // herb_id, o "herbId_symptomId" para tratamientos
  content      String                     @map("content") // texto exacto que se embebió (trazabilidad/debug)
  embedding    Unsupported("vector(768)") // Prisma no tipa vector: se maneja con $queryRaw desde Python (asyncpg), no desde NestJS

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  herb Herb @relation(fields: [herbId], references: [herb_id], onDelete: Cascade)

  // Unique compuesto: permite que el worker haga upsert idempotente
  // (ON CONFLICT (herb_id, source_type, source_id) DO UPDATE) sin duplicar filas
  // cuando se reindexa el mismo Herb varias veces.
  @@unique([herbId, sourceType, sourceId])
  @@index([herbId])
  @@map("tbl_herb_embedding")
}

enum TwoFactorPurpose {
  LOGIN
}

enum EmbeddingSource {
  HERB_PROFILE
  HERB_SYMPTOM
}

enum UserStatusEnum {
  ACTIVE
  INACTIVE
  DRAFT
  BLOCKED
}

enum CulturalCategory {
  TRADITIONAL_MEDICINE // Medicina tradicional
  ORAL_HISTORY // Historia oral
  RITUALS // Rituales y ceremonias
  GASTRONOMY // Gastronomía
  CRAFTS // Artesanía y oficios
  LANGUAGES // Lenguas y dialectos
  OTHER // Otro
}

enum StoryStatus {
  DRAFT // Borrador (solo el autor puede ver)
  PUBLISHED // Publicado (visible para todos)
  ARCHIVED // Archivado (sin indexar)
}
